# Kubernetes Secret Configuration Template
# Copy this file to secret.yaml and update with your actual credentials
# DO NOT commit secret.yaml to Git!

apiVersion: v1
kind: Secret
metadata:
  name: product-order-system-secret
type: Opaque
stringData:
  # Using stringData instead of data - Kubernetes will auto-encode to base64
  
  # Option 1: Local MongoDB (for local Kubernetes)
  # USER_MONGO_URI: mongodb://Test-user:27017/userdb
  # PRODUCT_MONGO_URI: mongodb://Test-product:27017/productdb
  # ORDER_MONGO_URI: mongodb://Test-order:27017/orderdb
  
  # Option 2: MongoDB Atlas (recommended for production)
  # Replace with your actual MongoDB Atlas connection strings
  USER_MONGO_URI: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/userdb?appName=Cluster0
  PRODUCT_MONGO_URI: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/productdb?appName=Cluster0
  ORDER_MONGO_URI: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/orderdb?appName=Cluster0
